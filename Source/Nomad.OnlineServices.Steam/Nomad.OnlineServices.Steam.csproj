<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>NomadFramework.OnlineServices.Steam</PackageId>
    <NoWarn>$(NoWarn);CA1506</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nomad.Core\Nomad.Core.csproj" />
    <ProjectReference Include="..\Nomad.Events\Nomad.Events.csproj" />
    <ProjectReference Include="..\Nomad.Logger\Nomad.Logger.csproj" />
    <ProjectReference Include="..\Nomad.CVars\Nomad.CVars.csproj" />
    <ProjectReference Include="..\Nomad.Input\Nomad.Input.csproj" />
    <ProjectReference Include="..\Nomad.Networking\Nomad.Networking.csproj" />
  </ItemGroup>

  <ItemGroup>
    <NomadNativeAsset Include="steam_api64.dll" HostOS="Windows" RuntimeIdentifier="win-x64" />
    <NomadNativeAsset Include="steam_api.dll" HostOS="Windows" RuntimeIdentifier="win-x86" />
    <NomadNativeAsset Include="libsteam_api.so" HostOS="Linux" RuntimeIdentifier="linux-x64" />
    <NomadNativeAsset Include="steam_api64.so" HostOS="Linux" RuntimeIdentifier="linux-x64" />
    <NomadNativeAsset Include="steam_api.so" HostOS="Linux" RuntimeIdentifier="linux-x64" />

    <Reference Include="Steamworks.NET">
      <HintPath>Steamworks.NET.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
