<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>NomadFramework.Core</PackageId>
    <UseNomadSourceGenerators>true</UseNomadSourceGenerators>
    <EnableEventDebug>true</EnableEventDebug>
    <IsNomadStandardLibraryProject>true</IsNomadStandardLibraryProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" />
    <PackageReference Include="System.Collections.Immutable" />
    <PackageReference Include="System.IO.Hashing" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>
</Project>
