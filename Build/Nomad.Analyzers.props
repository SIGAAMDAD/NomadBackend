<Project>
  <ItemGroup Condition="'$(UseNomadSourceGenerators)' == 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\Source\Nomad.SourceGenerators\Nomad.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>
</Project>